# Facebook Messenger API Configuration
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_VERIFY_TOKEN=church_webhook_verify_token_2025
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Server Configuration
PORT=3001
NODE_ENV=development
WEBHOOK_URL=https://your-domain.com/webhook/messenger

# Church Information
CHURCH_NAME=Quezon Central Church
CHURCH_ADDRESS=Your Church Address Here
CHURCH_PHONE=Your Phone Number
CHURCH_EMAIL=contact@quezoncentral.church
CHURCH_WEBSITE=https://your-website.com

# Database (if using one)
# DATABASE_URL=your_database_connection_string

# Optional: Logging and Monitoring
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn_for_error_tracking