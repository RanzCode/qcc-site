# Database Configuration
MONGODB_URI=mongodb://localhost:27017/quezon_central_church

# Server Configuration
PORT=3001

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://qccqonnect.org,https://www.qccqonnect.org

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:8b  # or llama3.2:1b, llama3.2:70b

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Admin login allowlist (comma-separated) - only these emails may log in with role=admin
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# Email Configuration (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Configuration (for donations)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Google API Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# YouTube Data API (used by the sermon/music-media import routes)
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

